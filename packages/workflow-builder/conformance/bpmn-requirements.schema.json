{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effect.website/schemas/workflow-builder/bpmn-requirements.schema.json",
  "title": "Effect Workflow Builder BPMN requirement catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "catalogId",
    "catalogRevision",
    "standard",
    "normativeCoverageComplete",
    "requirements",
    "profiles"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "catalogId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "catalogRevision": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "standard": {
      "$ref": "#/$defs/standard"
    },
    "normativeCoverageComplete": {
      "type": "boolean"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "authority",
        "specificationUrl"
      ],
      "properties": {
        "name": {
          "const": "Business Process Model and Notation"
        },
        "version": {
          "const": "2.0.2"
        },
        "authority": {
          "const": "Object Management Group"
        },
        "specificationUrl": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "document"
      ],
      "properties": {
        "authority": {
          "enum": [
            "OMG",
            "WorkflowPatterns"
          ]
        },
        "document": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "section": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "pages": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "facet",
        "source",
        "dependsOn"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "facet": {
          "enum": [
            "semantic-model",
            "execution-state",
            "execution",
            "xml-interchange",
            "diagram-interchange",
            "validation",
            "extension"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "notes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "profileRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "acceptedSupportLevels"
      ],
      "properties": {
        "requirementId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "acceptedSupportLevels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "modeled",
              "state-modeled",
              "executable",
              "interchange"
            ]
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "requirements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileRequirement"
          }
        }
      }
    }
  }
}
